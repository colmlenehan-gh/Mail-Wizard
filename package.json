{
  "name": "mail-wizard",
  "version": "0.1.0",
  "description": "A local-first email client, with an installable web app and a direct IMAP/SMTP desktop app.",
  "type": "module",
  "main": "desktop/main.cjs",
  "license": "MIT",
  "author": "Colm Lenehan",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "start": "electron .",
    "desktop:build": "electron-builder --publish never",
    "web": "python3 -m http.server 8000 --directory dist"
  },
  "dependencies": {
    "imapflow": "2.5.9",
    "mailparser": "3.10.0",
    "nodemailer": "10.1.7"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.mailwizard.client",
    "productName": "Mail Wizard",
    "directories": {"output": "release"},
    "files": ["desktop/**/*", "dist/**/*", "package.json", "LICENSE"],
    "win": {"target": ["nsis", "portable"], "icon": "dist/icons/icon.ico"},
    "mac": {"target": ["dmg", "zip"], "category": "public.app-category.productivity"},
    "linux": {"target": ["AppImage"], "category": "Network"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true}
  }
}
